{
  "name": "standalone-notes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && pnpm --filter standalone-notes-app-mcp-ui typecheck",
    "test": "node scripts/build.mjs && vitest run",
    "verify:vendor": "node scripts/verify-vendor.mjs"
  },
  "dependencies": {
    "@nexus-mindgarden/plugin-bridge-foundation": "file:vendor/plugin-bridge-foundation-0.21.0.tgz",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "svelte": "^5.56.9",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
